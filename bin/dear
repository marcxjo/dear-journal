#!/usr/bin/env bash

declare -r SCRIPT_NAME="${0##*/}"

# Dependencies #################################################################

require() {
    local -r dependency_name="$1"
    local -r cmd_variable="${dependency_name^^}_CMD"

    # Let users supply their own overrides for commands
    [ "${!cmd_variable:+x}" == "x" ] && return

    local dependency_fqp

    if ! dependency_fqp="$(type -P "$dependency_name" 2>/dev/null)"; then
        echo "Error: dependency $dependency_name is not installed"
        echo "$SCRIPT_NAME cannot run without this, exiting now"
        # I normally don't like exiting within a function, but we have no reason
        # to continue if we're missing runtime dependencies
        # Also, this is just a cool pattern - feels much like modern programming
        # language dependency management
        exit 1
    fi

    # Set a variable that allows us to conveniently invoke the command by its
    # full path
    printf -v "${cmd_variable}" '%s' "$dependency_fqp"
}

require pass #PASS_CMD
require tree #TREE_CMD

# Variables ####################################################################

# TODO: Not yet supported
# This is where we'll add libraries that extend the default journal features,
# such as to enable a bullet journal UX
declare -r DEAR_JOURNAL_LIB_DIR="${DEAR_JOURNAL_LIB_DIR:-${HOME}/.local/lib/dear}"

# shellcheck source=../lib/core.sh
[ -f "${DEAR_JOURNAL_LIB_DIR}/core.sh" ] && . "${DEAR_JOURNAL_LIB_DIR}/core.sh"

# The directory where all journals managed by `dear` are stored
declare -r DEAR_JOURNAL_SHELF_DIR="${DEAR_JOURNAL_SHELF_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/dear}"

declare DEAR_JOURNAL_DIR

# TODO: Not yet supported
# This will be useful for journals that allow multiple types of entry logging
# Thinking here again of UXes like bullet journals
declare DEAR_JOURNAL_NAMESPACE="${DEAR_JOURNAL_NAMESPACE:+${DEAR_JOURNAL_NAMESPACE%/}/}"

# Script settings
declare -i DEAR_JOURNAL_USE_FZF="${DEAR_JOURNAL_USE_FZF:-1}"

# TFM ##########################################################################

usage() {
    cat <<EOF
NAME
    $SCRIPT_NAME - an encrypted, extensible journaling experience powered by
    Unix password-store

SYNOPSIS
    $SCRIPT_NAME shelf
    $SCRIPT_NAME help

    $SCRIPT_NAME JOURNAL create|init KEY_ID
    $SCRIPT_NAME JOURNAL new [-d DATE]
    $SCRIPT_NAME JOURNAL edit PATH
    $SCRIPT_NAME JOURNAL [ls [PATH]]

DESCRIPTION
    Global commands:

    shelf
        Shows the current collection of journals managed by $SCRIPT_NAME

    help
        Displays this help message


    JOURNAL commands:

    Commands which operate on a specific journal within your shelf

    create|init
        Creates a new journal with name NAME using the GPG key with KEY_ID

    new
        Creates a new journal entry for DATE
        If DATE is not specified, defaults to today's date

    edit
        Opens the entry at PATH for editing
        Note that this command does NOT behave like the equivalent pass command
        If the entry does not exist, the command will fail
        To create a new entry, use the 'new' command

    ls
        Shows the contents of PATH within JOURNAL, or the full contents of
        JOURNAL if PATH is not specified
        This command will also be run if no arguments following JOURNAL are
        specified


    Environment variables:

    DEAR_JOURNAL_SHELF_DIR
        The directory where all journals managed by $SCRIPT_NAME are stored
        Defaults to \${CONFIG_HOME}/dear, where \${CONFIG_HOME} is equal to
        \${XDG_CONFIG_HOME} when set, otherwise \${HOME}/.config

EOF
}

# Private functions ############################################################

echo_err() {
    echo "$@" >&2
}

# Built-in Commands ############################################################

cmd_create() {
    if dear_core_pass_init "$@"; then
        return
    fi

    echo_err "Error: journal was not created."
    echo_err "       See \`$SCRIPT_NAME JOURNAL create KEY_ID\` to create a new journal."
    echo_err "       See \`$SCRIPT_NAME help\` for additional information."

    return 1
}

cmd_new() {
    local -r entry_path="$1"

    local -ri entry_count=$(find "${DEAR_JOURNAL_DIR}/${entry_path%/}/" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | wc -l)
    local -ri next_entry=$((entry_count + 1))

    dear_core_pass_edit "${entry_path}/${next_entry}"
}

cmd_edit() {
    if [ ${#@} -eq 0 ]; then
        echo_err "Error: No journal entry specified."
        echo_err "       See \`$SCRIPT_NAME ${DEAR_JOURNAL_DIR##*/} new\` if you meant to create a new entry."
        echo_err "       See \`$SCRIPT_NAME help\` for additional information."
        return 1
    fi

    local -r entry_fqp="$1"

    if [ ! -f "${DEAR_JOURNAL_DIR}/${entry_fqp}.gpg" ]; then
        echo_err "Error: journal contains no entries for ${entry_fqp}."
        echo_err "       See \`$SCRIPT_NAME ${DEAR_JOURNAL_DIR##*/} new\` if you meant to create a new entry."
        echo_err "       See \`$SCRIPT_NAME help\` for additional information."
        return 1
    fi

    if ! dear_core_pass_edit "${entry_fqp}"; then
        echo_err "Error: Journal entry was not saved."
        return 1
    fi
}

cmd_ls() {
    local -r entry_path="$1"
    local tree_header="${2:-${DEAR_JOURNAL_DIR##*/}}"

    IFS='/' read -ra segments <<<"$entry_path"

    local -i num_indents

    case "${#segments[@]}" in
    0)
        num_indents=3
        ;;
    1)
        tree_header=$(date --date="${segments[0]}/01/01" '+%Y' 2>/dev/null) &&
            num_indents=2 ||
            tree_header="$entry_path"
        ;;
    2)
        tree_header=$(date --date="${segments[0]}/${segments[1]}/01" '+%B %Y' 2>/dev/null) &&
            num_indents=1 ||
            tree_header="$entry_path"
        ;;
    3)
        tree_header=$(date --date="${segments[0]}/${segments[1]}/${segments[2]}" '+%x' 2>/dev/null) &&
            num_indents=0 ||
            tree_header="$entry_path"
        ;;
    *)
        tree_header="$entry_path"
        ;;
    esac

    if [ ! -x "${DEAR_JOURNAL_DIR}/${entry_path}" ]; then
        echo_err "Error: journal contains no entries for ${entry_path}."

        return 1
    fi

    dear_core_pass_ls "$entry_path" "$tree_header" $num_indents
}

cmd_grep() {
    dear_core_pass_grep "$@"
}

cmd_shelf() {
    echo "Your Shelf"
    tree -nClL1 --noreport "${DEAR_JOURNAL_SHELF_DIR}" | tail -n+2
}

# Main loop ####################################################################

if [ ${#@} -eq 0 ]; then
    cmd_shelf
    exit 0
fi

# We're not parsing a regex, just matching against an arg
# shellcheck disable=SC2076
[[ ! ' shelf help ' =~ " $1 " ]] &&
    DEAR_JOURNAL_DIR="${DEAR_JOURNAL_SHELF_DIR}/${1}" &&
    shift

declare cmd="$1"

if ! shift; then
    cmd_ls
    exit 0
fi

case "$cmd" in
'create' | 'init')
    cmd_create "$@"
    ;;
'new')
    declare -r datestamp="${2:-today}"
    read -r year month day <<<"$(date --date="$datestamp" '+%Y %m %d')"
    cmd_new "${year}/${month}/${day}"
    ;;
'edit')
    cmd_edit "$1"
    ;;
'ls')
    cmd_ls "$@"
    ;;
'grep')
    cmd_grep "$@"
    ;;
'shelf')
    cmd_shelf
    ;;
'help')
    usage
    exit 0
    ;;
*)
    # TODO: extension command support
    echo_err "Unknown command $1"
    exit 1
    ;;
esac
